# This repository is intentionally code-only. These rules are defense in depth;
# tools/validate_release.py is the authoritative pre-publication check.

# Research data and generated artifacts (at any depth)
**/*.dta
**/*.dtas
**/*.sav
**/*.zsav
**/*.por
**/*.sas7bdat
**/*.sas7bcat
**/*.xpt
**/*.xlsx
**/*.xls
**/*.xlsb
**/*.ods
**/*.csv
**/*.tsv
**/*.json
**/*.parquet
**/*.feather
**/*.arrow
**/*.rds
**/*.rda
**/*.rdata
**/*.RData
**/*.mat
**/*.dat
**/*.h5
**/*.hdf5
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.jsonl
**/*.ndjson
**/*.geojson
**/*.gpkg
**/*.gdb/
**/*.shp
**/*.shx
**/*.dbf
**/*.prj
**/*.kml
**/*.kmz
**/*.gph
**/*.ster

# Archives, disk images, and binary document bundles
**/*.zip
**/*.7z
**/*.rar
**/*.tar
**/*.tgz
**/*.gz
**/*.bz2
**/*.xz
**/*.zst
**/*.dmg
**/*.iso
**/*.doc
**/*.docx
**/*.pdf

# Logs, temporary files, and rendered results
**/*.log
**/*.smcl
**/*.tmp
**/*.temp
**/*.bak
**/*.backup
**/*.orig
**/*.swp
**/*.swo
**/*~
**/*.png
**/*.jpg
**/*.jpeg
**/*.gif
**/*.tif
**/*.tiff
**/*.eps
**/*.ps
**/*.tex
**/*.svg
**/*.aux
**/*.bbl
**/*.blg
**/*.toc
**/*.out
**/*.html
**/temp/
**/tmp/
**/logs/
**/results/
**/figures/
**/tables/

# The public tree retains only documentation placeholders in these directories.
/data/*
!/data/README.md
/rawdata/*
!/rawdata/README.md
/outputs/*
!/outputs/README.md

# Credentials and machine-local configuration
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.kdbx
**/.netrc
**/.Renviron
**/.Rhistory
**/.RData
**/.Rproj.user/

# Third-party Stata packages are installed upstream, not vendored here.
/ado/ssc/

# Operating-system, editor, and language caches
**/.DS_Store
**/Thumbs.db
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
